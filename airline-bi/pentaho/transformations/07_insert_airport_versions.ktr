  <order>
    <hop><from>Start</from><to>Read new or changed airports</to><enabled>Y</enabled></hop>
    <hop><from>Read new or changed airports</from><to>Insert airport version</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Start</name>
    <type>Start</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Read new or changed airports</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>OLTP</connection>
    <sql>WITH latest AS (
    SELECT airport_id, MAX(version) AS max_version
    FROM dw.dim_airport
    GROUP BY airport_id
)
SELECT s.airport_id,
       s.iata_code,
       s.airport_name,
       s.country_code,
       DATE &#x27;${SCD_AS_OF_DATE}&#x27; AS valid_from,
       DATE &#x27;9999-12-31&#x27; AS valid_to,
       TRUE AS is_current,
       COALESCE(l.max_version, 0) + 1 AS version
FROM oltp.airports s
LEFT JOIN latest l
       ON l.airport_id = s.airport_id
LEFT JOIN dw.dim_airport d
       ON d.airport_id = s.airport_id
      AND d.version = l.max_version
WHERE d.airport_key IS NULL
   OR d.airport_name &lt;&gt; s.airport_name</sql>
    <limit/>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>250</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Insert airport version</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW</connection>
    <schema>dw</schema>
    <table>dim_airport</table>
    <commit>5000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields></fields>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>750</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>

