    </attributes>
  </connection>

  <order>
    <hop><from>Start</from><to>Read flight records with surrogate keys</to><enabled>Y</enabled></hop>
    <hop><from>Read flight records with surrogate keys</from><to>Load fact_flight</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Start</name>
    <type>Start</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Read flight records with surrogate keys</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>OLTP</connection>
    <sql>SELECT f.flight_id,
       dd.date_key AS flight_date_key,
       da.airport_key,
       dc.country_key,
       dp.passenger_key,
       dpl.pilot_key,
       ds.status_key,
       1::smallint AS flight_count,
       1::smallint AS passenger_count,
       ds.is_operated,
       ds.is_on_time,
       ds.is_delayed,
       ds.is_cancelled
FROM oltp.flights f
JOIN oltp.airports a          ON a.airport_id = f.origin_airport_id
JOIN oltp.countries c        ON c.country_code = a.country_code
JOIN oltp.passengers p       ON p.passenger_id = f.passenger_id
JOIN oltp.pilots pl          ON pl.pilot_id = f.pilot_id
JOIN oltp.flight_statuses s  ON s.status_id = f.status_id
JOIN dw.dim_date dd          ON dd.full_date = f.flight_date
JOIN dw.dim_airport da       ON da.airport_id = a.airport_id
                            AND f.flight_date BETWEEN da.valid_from AND da.valid_to
JOIN dw.dim_country dc       ON dc.country_code = c.country_code
JOIN dw.dim_passenger dp     ON dp.passenger_id = p.passenger_id
JOIN dw.dim_pilot dpl        ON dpl.pilot_id = pl.pilot_id
JOIN dw.dim_flight_status ds ON ds.status_code = s.status_code</sql>
    <limit/>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>250</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Load fact_flight</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW</connection>
    <schema>dw</schema>
    <table>fact_flight</table>
    <commit>5000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields></fields>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>750</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>

  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
</transformation>
