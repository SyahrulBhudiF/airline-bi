    <GUI><xloc>100</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Read daily country snapshot</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>OLTP</connection>
    <sql>SELECT dd.date_key AS snapshot_date_key,
       dc.country_key,
       COUNT(f.flight_id)::int AS flight_count,
       COALESCE(SUM(f.passenger_count), 0)::int AS passenger_count,
       COALESCE(SUM(f.is_operated), 0)::int AS operated_flights,
       COALESCE(SUM(f.is_on_time), 0)::int AS on_time_flights,
       COALESCE(SUM(f.is_delayed), 0)::int AS delayed_flights,
       COALESCE(SUM(f.is_cancelled), 0)::int AS cancelled_flights,
       CASE WHEN COALESCE(SUM(f.is_operated), 0) = 0 THEN 0
            ELSE ROUND(SUM(f.is_on_time)::numeric / SUM(f.is_operated), 4) END AS on_time_rate,
       CASE WHEN COUNT(f.flight_id) = 0 THEN 0
            ELSE ROUND(SUM(f.is_cancelled)::numeric / COUNT(f.flight_id), 4) END AS cancellation_rate
FROM dw.dim_date dd
CROSS JOIN dw.dim_country dc
LEFT JOIN dw.fact_flight f
       ON f.flight_date_key = dd.date_key
      AND f.country_key = dc.country_key
WHERE dd.year = 2022
GROUP BY dd.date_key, dc.country_key</sql>
    <limit/>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>250</xloc><yloc>100</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Load fact_daily_country_snapshot</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DW</connection>
    <schema>dw</schema>
    <table>fact_daily_country_snapshot</table>
    <commit>5000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
